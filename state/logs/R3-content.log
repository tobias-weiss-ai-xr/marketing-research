\end{tabular}
\begin{tablenotes}
\item The best context-blind policy (+\$252.41) beats every deployable context-aware agent in 7 of 9 environments. This is a benchmark-construction limitation (\S9.2 \#25). The multi-signal gain is measured within the context-aware ladder; a context-blind policy on a cheap channel can beat a context-aware policy on an expensive channel.
\end{tablenotes}
\end{table}

